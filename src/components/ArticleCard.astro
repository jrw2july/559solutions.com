---
import TagList from "./TagList.astro";

interface Props {
  title: string;
  slug: string;
  summary: string;
  category: string;
  date: Date;
  tags: string[];
}

const { title, slug, summary, category, date, tags } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(date);
---

<article
  class="card article-card"
  data-filter-card
  data-category={category.toLowerCase()}
  data-topics={tags.join(" ").toLowerCase()}
  data-search={`${title} ${summary} ${category} ${tags.join(" ")}`.toLowerCase()}
>
  <p class="article-kicker">{category} <span aria-hidden="true">·</span> <time datetime={date.toISOString()}>{formattedDate}</time></p>
  <h3><a href={`/blog/${slug}/`}>{title}</a></h3>
  <p>{summary}</p>
  <TagList {tags} />
  <a class="text-link" href={`/blog/${slug}/`} aria-label={`Read ${title}`}>Read article</a>
</article>
