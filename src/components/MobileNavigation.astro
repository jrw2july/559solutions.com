---
import { sitePath } from "@/config/site";
import { headerNavigation } from "@/data/navigation";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);

const links = headerNavigation.filter((item) => item.href !== "/contact/");
const contact = headerNavigation.find((item) => item.href === "/contact/");
---

<details class="mobile-nav">
  <summary aria-label="Open site navigation">
    <span aria-hidden="true" class="menu-icon"></span>
    <span>Menu</span>
  </summary>
  <nav aria-label="Mobile">
    <ul>
      <li><a href={sitePath("/")} aria-current={currentPath === "/" ? "page" : undefined}>Home</a></li>
      {
        links.map((item) => (
          <li class:list={[item.href === "/code559/" && "nav-logo"]}>
            <a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.href === "/code559/" ? (
                <img src={sitePath("/images/code559-logo.png")} alt="Code559" width="760" height="308" decoding="async" />
              ) : (
                item.label
              )}
            </a>
          </li>
        ))
      }
      {
        contact && (
          <li>
            <a class="button button-primary button-small" href={sitePath(contact.href)}>
              {contact.label}
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</details>
