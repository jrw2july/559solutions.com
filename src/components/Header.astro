---
import { site, sitePath } from "@/config/site";
import { headerNavigation } from "@/data/navigation";
import { rooms } from "@/data/rooms";
import MobileNavigation from "./MobileNavigation.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);

// The Code559 link is labeled with its room on the plan, "The Workshop", and sits in the center of the header.
// The other links sit at the far right, ending with Contact as the button.
const code559 = headerNavigation.find((item) => item.href === "/code559/");
const contact = headerNavigation.find((item) => item.href === "/contact/");
const links = headerNavigation.filter((item) => item !== code559 && item !== contact);
const workshopLabel = rooms.find((room) => room.id === "workshop")?.label ?? "The Workshop";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={sitePath("/")} aria-label="559 Solutions home">
      <img
        src={sitePath(site.logoPath)}
        alt="559 Solutions"
        width="720"
        height="358"
        decoding="async"
      />
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      {
        code559 && (
          <a class="nav-center" href={sitePath(code559.href)} aria-current={isCurrent(code559.href) ? "page" : undefined}>
            {workshopLabel}
          </a>
        )
      }
      <ul class="nav-links">
        {
          links.map((item) => (
            <li>
              <a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        {
          contact && (
            <li>
              <a class="button button-primary header-cta" href={sitePath(contact.href)}>
                {contact.label}
              </a>
            </li>
          )
        }
      </ul>
    </nav>
    <MobileNavigation {currentPath} />
  </div>
</header>
