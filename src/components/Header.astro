---
import { site, sitePath } from "@/config/site";
import { headerNavigation } from "@/data/navigation";
import MobileNavigation from "./MobileNavigation.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);

// Code559 keeps its own brand: its menu entry is its logo. Contact is the header button.
const links = headerNavigation.filter((item) => item.href !== "/contact/");
const contact = headerNavigation.find((item) => item.href === "/contact/");
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={sitePath("/")} aria-label="559 Solutions home">
      <img
        src={sitePath(site.logoPath)}
        alt="559 Solutions"
        width="720"
        height="358"
        decoding="async"
      />
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {
          links.map((item) =>
            item.href === "/code559/" ? (
              <li class="nav-logo">
                <a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  <img src={sitePath("/images/code559-logo.png")} alt="Code559" width="760" height="308" decoding="async" />
                </a>
              </li>
            ) : (
              <li>
                <a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
    {
      contact && (
        <a class="button button-primary header-cta" href={sitePath(contact.href)}>
          {contact.label}
        </a>
      )
    }
    <MobileNavigation {currentPath} />
  </div>
</header>
