---
import { site, sitePath } from "@/config/site";
import { headerNavigation } from "@/data/navigation";
import { rooms } from "@/data/rooms";
import MobileNavigation from "./MobileNavigation.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);

// The Code559 link is labeled with its room on the plan, "The Classroom". All links sit at the right,
// ending with Contact as the button (2026-10-14).
const contact = headerNavigation.find((item) => item.href === "/contact/");
const links = headerNavigation.filter((item) => item !== contact);
const classroomLabel = rooms.find((room) => room.id === "classroom")?.label ?? "The Classroom";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={sitePath("/")} aria-label="559 Solutions home">
      <img
        src={sitePath(site.logoPath)}
        alt="559 Solutions"
        width="720"
        height="358"
        decoding="async"
      />
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul class="nav-links">
        {
          links.map((item) => (
            <li>
              <a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.href === "/code559/" ? classroomLabel : item.label}
              </a>
            </li>
          ))
        }
        {
          contact && (
            <li>
              <a class="button button-primary header-cta" href={sitePath(contact.href)}>
                {contact.label}
              </a>
            </li>
          )
        }
      </ul>
    </nav>
    <MobileNavigation {currentPath} />
  </div>
</header>
