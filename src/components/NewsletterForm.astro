---
// The Curious Architect email signup (2026-11-05). It posts to the site's Google Apps Script web app,
// which adds one row to the Google Sheet: the email, consent, the page, and a source tag such as
// "newsletter:start-with-the-decision-not-the-ai-tool". The script sends no email; the owner does.
// With JavaScript, site.js posts it and shows the result here. Without JavaScript the browser posts the
// form itself, and the script answers with a short thank-you page (docs/apps-script-form-handler.gs).
// No popups or overlays, and no subscriber counts. Worksheet text is never part of this form.
import { site, sitePath } from "@/config/site";

interface Props {
  /** Unique on the page; used for element ids. */
  id: string;
  /** Source tag recorded with the signup, e.g. the article slug. */
  tag: string;
  heading?: string;
  offer?: string;
  /** Id for the section, so a link can jump to it. */
  anchor?: string;
}

const { id, tag, anchor } = Astro.props;
const {
  heading = "Get the next article by email",
  offer = "Get an email when a new Curious Architect article is published. Nothing else. Unsubscribe anytime by replying.",
} = Astro.props;
const eyebrow = "The Curious Architect by email";
const consent = "I agree that 559 Solutions may email me when a new article is published.";
const success = "Thanks, you're on the list. You'll get an email when a new article is published.";
const configured = Boolean(site.newsletterEndpoint);
const source = `newsletter:${tag}`;
const page = Astro.url.pathname;
---

<section class="newsletter-card" id={anchor} aria-labelledby={`${id}-heading`}>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={`${id}-heading`} data-toc-skip>{heading}</h2>
    <p>{offer}</p>
  </div>
  <form
    class="newsletter-form"
    action={configured ? site.newsletterEndpoint : undefined}
    method="post"
    aria-labelledby={`${id}-heading`}
    data-ajax-form={configured ? source : undefined}
    data-success-message={success}
  >
    <input type="hidden" name="source" value={source} />
    <input type="hidden" name="page" value={page} />
    <div class="field">
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
    </div>
    <div class="honeypot" aria-hidden="true">
      <label for={`${id}-company-website`}>Leave this field blank</label>
      <input id={`${id}-company-website`} name={site.antiSpamField} type="text" tabindex="-1" autocomplete="off" />
    </div>
    <label class="checkbox-field">
      <input name="consent" type="checkbox" required />
      <span>{consent} See the <a href={sitePath("/privacy/")}>Privacy Policy</a>.</span>
    </label>
    <button class="button button-primary button-small" type="submit" disabled={!configured}>Sign up</button>
    {
      !configured && (
        <p class="form-notice">Email signup is not set up yet. You can follow new articles by <a href={sitePath("/rss.xml")}>RSS</a>.</p>
      )
    }
    <p class="form-status" data-form-status role="status" aria-live="polite"></p>
  </form>
</section>
