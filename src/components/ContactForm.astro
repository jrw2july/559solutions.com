---
import { site, sitePath } from "@/config/site";

const configured = Boolean(site.contactFormEndpoint);
---

<form
  class="form-panel contact-form"
  action={configured ? site.contactFormEndpoint : undefined}
  method="post"
  data-ajax-form={configured ? "contact" : undefined}
>
  <div class="form-grid">
    <div class="field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="contact-email">Email</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required />
    </div>
  </div>
  <div class="field">
    <label for="contact-organization">Organization <span class="optional">(optional)</span></label>
    <input id="contact-organization" name="organization" type="text" autocomplete="organization" />
  </div>
  <div class="field">
    <label for="contact-inquiry">Inquiry type</label>
    <select id="contact-inquiry" name="inquiry_type" required>
      <option value="">Choose one</option>
      <option value="product-question">Product question</option>
      <option value="business-systems-clarity-session">Business-systems clarity session</option>
      <option value="ai-workflow-assessment">AI workflow assessment</option>
      <option value="low-code-solution-design">Low-code solution design</option>
      <option value="technical-mentoring">Technical mentoring</option>
      <option value="speaking-or-workshop">Speaking or workshop</option>
      <option value="other">Other</option>
    </select>
  </div>
  <div class="field">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" rows="7" minlength="20" required></textarea>
    <p class="field-hint">Please describe the work, decision, repeated task, or source of confusion.</p>
  </div>
  <div class="honeypot" aria-hidden="true">
    <label for="contact-company-website">Leave this field blank</label>
    <input id="contact-company-website" name={site.antiSpamField} type="text" tabindex="-1" autocomplete="off" />
  </div>
  <label class="checkbox-field">
    <input name="privacy_consent" type="checkbox" required />
    <span>I agree that 559 Solutions may use this information to respond to my inquiry. See the <a href={sitePath("/privacy/")}>Privacy Policy</a>.</span>
  </label>
  <button class="button button-primary" type="submit" disabled={!configured}>Send inquiry</button>
  {
    !configured && (
      <div class="form-notice" role="status">
        <p>The online form is not active because a secure endpoint has not been configured.</p>
        {
          site.publicEmail ? (
            <p>Email <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a> instead.</p>
          ) : (
            <p>A public email address also requires owner configuration before this site is published.</p>
          )
        }
      </div>
    )
  }
  <p class="form-status" data-form-status role="status" aria-live="polite"></p>
</form>
