---
import { sitePath } from "@/config/site";
// Decorative divider from the 559 Solutions logo frame: a double wall line, a window, and a door swing.
---

<div class="floorplan-divider" aria-hidden="true">
  <img class="fp-wall fp-wall-1" src={sitePath("/images/brand/floorplan-wall.svg")} alt="" width="100" height="34" />
  <img class="fp-window" src={sitePath("/images/brand/floorplan-window.svg")} alt="" width="70" height="34" />
  <img class="fp-wall fp-wall-3" src={sitePath("/images/brand/floorplan-wall.svg")} alt="" width="100" height="34" />
  <img class="fp-door" src={sitePath("/images/brand/floorplan-door.svg")} alt="" width="46" height="34" />
</div>
