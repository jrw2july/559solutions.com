---
import { sitePath } from "@/config/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={["author-bio", compact && "author-bio-compact"]} aria-labelledby="author-bio-title">
  <div class="author-mark" aria-hidden="true">JW</div>
  <div>
    <h2 id="author-bio-title">About Joel Wells</h2>
    <p>
      Joel is a solution architect, mentor, teacher, and builder who translates complicated
      work into practical systems, reusable resources, and plain-language guidance.
    </p>
    <a class="text-link" href={sitePath("/about/")}>About 559 Solutions</a>
  </div>
</aside>
