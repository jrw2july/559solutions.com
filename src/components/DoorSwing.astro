// The leaf rotates open on hover and focus (see .door-leaf in global.css).
---

<svg class="door-swing" viewBox="0 0 64 44" width="64" height="44" aria-hidden="true" focusable="false">
  <line x1="0" y1="40" x2="4" y2="40" stroke-width="3"></line>
  <line x1="40" y1="40" x2="64" y2="40" stroke-width="3"></line>
  <path d="M40 40 A36 36 0 0 0 4 4" stroke-width="1.2" stroke-dasharray="3 3"></path>
  <line class="door-leaf" x1="4" y1="40" x2="40" y2="40" stroke-width="2.5"></line>
</svg>
