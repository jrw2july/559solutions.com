---
import { copyrightYear, site, sitePath } from "@/config/site";
import { legalNavigation, primaryNavigation } from "@/data/navigation";
import OwnerName from "./OwnerName.astro";

// The footer is the title block of the drawing set (2026-10-14): the strip of labelled cells an architect
// signs in the corner of every sheet. Links keep their nav semantics; the labels are the cell headings.
---

<footer class="site-footer">
  <div class="container">
    <div class="sheet-block">
      <div class="sheet-cell sheet-cell-project">
        <h2>Project</h2>
        <a class="footer-brand" href={sitePath("/")} aria-label="559 Solutions home">559 Solutions</a>
        <p>Practical AI, automation, low-code tools, and plain-language systems guidance.</p>
        <p class="footer-note">The real product is clarity.</p>
      </div>
      <nav class="sheet-cell" aria-label="Footer">
        <h2>Drawing index</h2>
        <ul>
          {primaryNavigation.map((item) => <li><a href={sitePath(item.href)}>{item.label}</a></li>)}
        </ul>
      </nav>
      <nav class="sheet-cell" aria-label="Legal">
        <h2>General notes</h2>
        <ul>
          {legalNavigation.map((item) => <li><a href={sitePath(item.href)}>{item.label}</a></li>)}
          <li><a href={sitePath("/rss.xml")}>RSS feed</a></li>
        </ul>
      </nav>
      <div class="sheet-cell">
        <h2>Issued for</h2>
        <p>Tell 559 Solutions what is confusing, repeated, or difficult to maintain.</p>
        <a class="text-link" href={sitePath("/contact/")}>Contact 559 Solutions</a>
      </div>
      <div class="sheet-cell sheet-cell-small">
        <h2>Drawn by</h2>
        <p><OwnerName /></p>
      </div>
      <div class="sheet-cell sheet-cell-small">
        <h2>Studio</h2>
        <p>{site.siteName}</p>
      </div>
      <div class="sheet-cell sheet-cell-small">
        <h2>Sheet</h2>
        <p>A-000 · Cover</p>
      </div>
      <div class="sheet-cell sheet-cell-small">
        <h2>Scale</h2>
        <p>1 : simplest useful</p>
      </div>
      <div class="sheet-cell sheet-cell-small">
        <h2>Date</h2>
        <p>&copy; {copyrightYear} {site.siteName}. All rights reserved.</p>
      </div>
      <div class="sheet-cell sheet-cell-small">
        <h2>Revision</h2>
        <p><a href={sitePath("/accessibility/")}>Accessibility commitment</a></p>
      </div>
    </div>
  </div>
</footer>
