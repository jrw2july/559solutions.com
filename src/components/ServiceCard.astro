---
import { sitePath } from "@/config/site";
import type { Service } from "@/data/services";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
---

<article class="card service-card" id={service.slug}>
  <div class="card-meta">
    <span class="card-number">{String(index).padStart(2, "0")}</span>
    <StatusBadge status={service.status} />
  </div>
  <h3>{service.title}</h3>
  <p>{service.purpose}</p>
  <h4>Possible scope</h4>
  <ul class="check-list">
    {service.deliverables.map((item) => <li>{item}</li>)}
  </ul>
  {service.note && <p class="small-note">{service.note}</p>}
  <a class="text-link" href={sitePath(`/contact/?inquiry=${service.slug}`)}>
    Ask about {service.title}
  </a>
</article>
