---
interface Props {
  label: string;
  searchPlaceholder: string;
  categories: string[];
  secondaryLabel?: string;
  secondaryOptions?: string[];
  secondaryAttribute?: "audience" | "topics";
  /**
   * Blog mode (2026-11-05): the form needs JavaScript (a static page cannot filter by itself), so it
   * stays hidden until site.js shows it. It filters live, so there is no Apply button. Filters are
   * kept in the URL (?category=, ?tag=, ?search=) and the result count is announced.
   */
  live?: boolean;
  /** Plural noun for the announced count in blog mode, e.g. "articles". */
  itemNoun?: [singular: string, plural: string];
  /** Blog mode: article formats to filter by (2026-11-05). Cards carry data-format. */
  formatOptions?: { slug: string; label: string }[];
}

const {
  label,
  searchPlaceholder,
  categories,
  secondaryLabel,
  secondaryOptions = [],
  secondaryAttribute = "topics",
  live = false,
  itemNoun = ["item", "items"],
  formatOptions = [],
} = Astro.props;
// In blog mode nothing is submitted, so the controls are a search group, not a form.
const Tag = live ? "div" : "form";
---

<Tag
  class="filter-bar"
  role={live ? "search" : undefined}
  data-filter-form
  data-secondary-attribute={secondaryAttribute}
  data-live={live ? "" : undefined}
  data-js-only={live ? "" : undefined}
  data-noun-singular={live ? itemNoun[0] : undefined}
  data-noun-plural={live ? itemNoun[1] : undefined}
  hidden={live}
  aria-label={label}
>
  <div class="field">
    <label for="filter-search">Search</label>
    <input id="filter-search" name="search" type="search" placeholder={searchPlaceholder} data-filter-search />
  </div>
  {/* In blog mode the category links choose the category; this hidden select only holds the choice. */}
  <div class="field" hidden={live}>
    <label for="filter-category">Category</label>
    <select id="filter-category" name="category" data-filter-category>
      <option value="">All categories</option>
      {categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
    </select>
  </div>
  {
    secondaryLabel && secondaryOptions.length > 0 && (
      <div class="field">
        <label for="filter-secondary">{secondaryLabel}</label>
        <select id="filter-secondary" name="secondary" data-filter-secondary>
          <option value="">All {secondaryLabel.toLowerCase()}</option>
          {secondaryOptions.map((option) => <option value={option.toLowerCase()}>{option}</option>)}
        </select>
      </div>
    )
  }
  {
    live && formatOptions.length > 0 && (
      <div class="field">
        <label for="filter-format">Format</label>
        <select id="filter-format" name="format" data-filter-format>
          <option value="">All formats</option>
          {formatOptions.map((option) => <option value={option.slug}>{option.label}</option>)}
        </select>
      </div>
    )
  }
  {!live && <button class="button button-primary button-small" type="submit">Apply filters</button>}
  {
    live ? (
      <button class="button button-secondary button-small" type="button" data-filter-clear>Clear filters</button>
    ) : (
      <button class="button button-secondary button-small" type="reset">Clear filters</button>
    )
  }
</Tag>
<p class="filter-status" data-filter-status role={live ? "status" : undefined} aria-live="polite"></p>
