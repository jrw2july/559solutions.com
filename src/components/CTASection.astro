---
interface Props {
  title: string;
  description?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="cta-section">
  <div class="container cta-inner">
    <div>
      <p class="eyebrow">The next useful step</p>
      <h2>{title}</h2>
      {description && <p>{description}</p>}
    </div>
    <div class="button-row">
      <a class="button button-light" href={primaryHref}>{primaryLabel}</a>
      {
        secondaryLabel && secondaryHref && (
          <a class="button button-outline-light" href={secondaryHref}>{secondaryLabel}</a>
        )
      }
    </div>
  </div>
</section>
