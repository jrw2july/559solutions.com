---
import { sitePath } from "@/config/site";
import DoorSwing from "./DoorSwing.astro";

// A door card: a room in plan view. The door leaf swings open on hover and keyboard focus.
interface Props {
  number: string;
  title: string;
  description: string;
  cta?: string;
  href?: string;
}

const { number, title, description, cta, href } = Astro.props;
---

<article class="door-card">
  <DoorSwing />
  <p class="plan-tag">Room {number}</p>
  <h3>{title}</h3>
  <p>{description}</p>
  {cta && href && <a class="text-link" href={sitePath(href)}>{cta}</a>}
</article>
