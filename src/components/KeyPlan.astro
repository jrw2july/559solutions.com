---
import { sitePath } from "@/config/site";
import { roomForPath } from "@/data/rooms";
import PlanDrawing from "./PlanDrawing.astro";

// The small key plan under the header: the whole site in miniature, with the current room filled in.
// Pages that are not rooms (About, Contact, privacy, terms, accessibility, 404) show the plan with nothing
// filled and a caption of their own ("Site information" unless the page supplies one).
interface Props {
  currentPath: string;
  caption?: string;
}

const { currentPath, caption = "Site information" } = Astro.props;
const here = roomForPath(currentPath);
const label = here ? `Key plan: you are in ${here.label}` : "Key plan of the site";
---

<div class="keyplan-bar">
  <div class="container keyplan-inner">
    <PlanDrawing hereId={here?.id} {label} />
    <p class="keyplan-caption">
      <span class="plan-tag">{here ? "You are here" : caption}</span>
      {here && <strong>{here.label}</strong>}
      {here && <span class="keyplan-page">{here.page}</span>}
    </p>
    <a class="keyplan-back" href={sitePath("/")}>Back to the plan</a>
  </div>
</div>
