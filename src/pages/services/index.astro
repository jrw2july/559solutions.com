---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CTASection from "@/components/CTASection.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import { services } from "@/data/services";
import { site, sitePath } from "@/config/site";

// The entry offer shows only when the owner has turned it on and filled in every field (src/config/site.ts).
const offer = site.entryOffer;
const showOffer = offer.enabled && [offer.name, offer.duration, offer.deliverable, offer.price].every((value) => value.trim() !== "");
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Practical Services | 559 Solutions"
  description="Focused systems clarity, AI workflow assessment, low-code solution design, technical mentoring, and fixed-scope systems work by inquiry."
  canonicalPath="/services/"
>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Services" }]} />
      <p class="eyebrow">Focused help</p>
      <h1>Focused help when you need a second set of eyes.</h1>
      <p class="lede">
        559 Solutions starts with the work, decision, process, or source of confusion. Technology comes after the problem is understood.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="By inquiry"
        title="Defined services, without big-consulting overhead."
        description="Every engagement begins with a clear scope. No duration, capacity, result, or price is promised until it is confirmed directly."
      />
      <div class="card-grid card-grid-2">
        {services.map((service, index) => <ServiceCard {service} index={index + 1} />)}
      </div>
    </div>
  </section>

  {
    showOffer && (
      <section class="section entry-offer" aria-labelledby="entry-offer-heading">
        <div class="container">
          <p class="eyebrow">Fixed-scope first step</p>
          <h2 id="entry-offer-heading">{offer.name}</h2>
          <dl class="entry-offer-terms">
            <div>
              <dt>Length</dt>
              <dd>{offer.duration}</dd>
            </div>
            <div>
              <dt>You receive</dt>
              <dd>{offer.deliverable}</dd>
            </div>
            <div>
              <dt>Price</dt>
              <dd>{offer.price}</dd>
            </div>
          </dl>
          <a class="button button-primary" href={sitePath(`/contact/?inquiry=${offer.inquiry}`)}>Ask about {offer.name}</a>
        </div>
      </section>
    )
  }

  <section class="section section-blue">
    <div class="container">
      <SectionHeading
        eyebrow="Before an engagement"
        title="Start with four practical questions."
      />
      <ol class="question-list">
        <li>What work, decision, or handoff is creating friction?</li>
        <li>Who owns the current process and the desired result?</li>
        <li>What is the smallest useful improvement?</li>
        <li>What must the team be able to understand and maintain afterward?</li>
      </ol>
    </div>
  </section>

  <CTASection
    title="Tell me what is not working."
    description="Describe the work in plain language. A useful first response does not require a polished requirements document."
    primaryLabel="Start an Inquiry"
    primaryHref="/contact/"
    secondaryLabel="Read the Articles First"
    secondaryHref="/blog/"
  />
</BaseLayout>
