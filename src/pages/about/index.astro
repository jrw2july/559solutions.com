---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CTASection from "@/components/CTASection.astro";
import OwnerName from "@/components/OwnerName.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/config/site";
import { rooms } from "@/data/rooms";

// The About page: who the architect is, then the plan of the site read as the kinds of help 559 Solutions gives.
// Each room on the plan is one kind of help; the hall is where a conversation starts.
const roomNotes: Record<string, { analogy: string; go: string }> = {
  library: {
    analogy:
      "An architect keeps a library of standards and references. Here it holds workbooks, starter kits, and templates: guidance you take back to your own work.",
    go: "Browse the Library",
  },
  study: {
    analogy:
      "Where the thinking is written down. Articles about clearer systems and calmer technology decisions. The Curious Architect is the 559 Solutions blog, not a separate company.",
    go: "Read the blog",
  },
  classroom: {
    analogy: "Where the instruction happens. Coding and AI tools for regular people, taught one course at a time.",
    go: "Go to Code559",
  },
};
---

<BaseLayout
  title="About 559 Solutions | Practical Systems by Joel Wells"
  description="Learn how Joel Wells and 559 Solutions turn complicated work into practical tools, plain-language guidance, and reusable systems."
  canonicalPath="/about/"
  planCaption="The architect"
>
  <section class="page-hero plan-ground about-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About 559" }]} />
      <div class="about-grid">
        <div class="about-me">
          <p class="eyebrow">About 559 Solutions</p>
          <h1>About me</h1>
          <p class="lede">
            I am <OwnerName />, a solution architect, mentor, teacher, and builder. For more than three decades, I have helped teams understand complicated work and turn it into systems people can actually use.
          </p>
          <p>
            559 Solutions is where I translate that experience into practical tools, plain-language guidance, reusable resources, and focused services.
          </p>
          <p>
            The method is deliberately calm: understand the work, name the decision, make ownership visible, choose the smallest useful response, then make the result easier to repeat and maintain.
          </p>
          <p>
            An architect draws the plan before anyone builds. That is how 559 Solutions works: before a tool is chosen, the work is understood. This site is drawn the same way. Each room is one kind of help.
          </p>
        </div>
        <div class="about-rooms">
          <p class="plan-tag">Room schedule</p>
        <ol class="schedule room-schedule">
          {
            rooms.map((room, index) => {
              const note = roomNotes[room.id];
              return (
                <li>
                  <span class="plan-tag">Room {String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <p class="schedule-name">
                      {room.label} <span class="schedule-page">{room.page}</span>
                    </p>
                    {note && <p>{note.analogy}</p>}
                    {note && <a class="text-link" href={sitePath(room.href)}>{note.go}</a>}
                  </div>
                </li>
              );
            })
          }
          <li>
            <span class="plan-tag">Hall</span>
            <div>
              <p class="schedule-name">The Hall <span class="schedule-page">Contact</span></p>
              <p>Where we meet. If the work is confusing, repeated, or hard to maintain, start here.</p>
              <a class="text-link" href={sitePath("/contact/")}>Tell me what is not working</a>
            </div>
          </li>
        </ol>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Bring the messy version."
    description="You do not need to explain the problem in technical language."
    primaryLabel="Tell Me What Is Not Working"
    primaryHref="/contact/"
    secondaryLabel="Explore Practical Resources"
    secondaryHref="/resources/"
  />
</BaseLayout>
