---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CTASection from "@/components/CTASection.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="About 559 Solutions | Practical Systems by Joel Wells"
  description="Learn how Joel Wells and 559 Solutions turn complicated work into practical tools, plain-language guidance, and reusable systems."
  canonicalPath="/about/"
>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About 559" }]} />
      <p class="eyebrow">About 559 Solutions</p>
      <h1>I do not start with software. I start with the work.</h1>
      <p class="lede">
        559 Solutions helps small teams and business owners turn messy work into clear systems using practical AI, low-code tools, and plain-language design.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container resource-layout">
      <div>
        <SectionHeading
          eyebrow="The practical business"
          title="Experience translated into systems people can use."
        />
        <p>
          I am Joel Wells, a solution architect, mentor, teacher, and builder. For more than three decades, I have helped teams understand complicated work and turn it into systems people can actually use.
        </p>
        <p>
          559 Solutions is where I translate that experience into practical tools, plain-language guidance, reusable resources, and focused services.
        </p>
        <p>
          The method is deliberately calm: understand the work, name the decision, make ownership visible, choose the smallest useful response, then make the result easier to repeat and maintain.
        </p>
      </div>
      <aside class="detail-panel" aria-label="559 Solutions approach">
        <h2>The real product is clarity.</h2>
        <p>
          AI, automation, and low-code platforms can be useful. They are selected only after the problem, people, risks, and desired outcome are understood.
        </p>
      </aside>
    </div>
  </section>

  <section class="section section-tinted">
    <div class="container">
      <SectionHeading
        eyebrow="What this means for you"
        title="Begin with the questions that reveal the system."
      />
      <ul class="question-list">
        <li>What is confusing?</li>
        <li>What keeps repeating?</li>
        <li>Where are people losing time?</li>
        <li>What decisions are unclear?</li>
        <li>What could be simplified, automated, or taught better?</li>
      </ul>
      <p class="hero-lede"><strong>Then we design the simplest useful system.</strong></p>
    </div>
  </section>

  <section class="section">
    <div class="container resource-layout">
      <div>
        <SectionHeading
          eyebrow="One business, two lenses"
          title="559 Solutions and The Curious Architect."
        />
        <p>
          <strong>559 Solutions</strong> is the practical business. It is the home for resources, services, and systems guidance.
        </p>
        <p>
          <strong>The Curious Architect</strong> is a subtle editorial theme behind selected articles and commentary about systems thinking, decisions, technology and society, leadership, craftsmanship, chess, and strategy.
        </p>
        <p>It is not a separate company or a competing brand.</p>
      </div>
      <aside class="detail-panel" aria-label="Practical themes">
        <h2>Practical themes</h2>
        <ul class="check-list">
          <li>Solution architecture</li>
          <li>Enterprise systems</li>
          <li>Low-code platforms</li>
          <li>AI-assisted design</li>
          <li>Mentoring and teaching</li>
          <li>Systems thinking</li>
        </ul>
      </aside>
    </div>
  </section>

  <CTASection
    title="Bring the messy version."
    description="You do not need to explain the problem in technical language."
    primaryLabel="Tell Me What Is Not Working"
    primaryHref="/contact/"
    secondaryLabel="Explore Practical Resources"
    secondaryHref="/resources/"
  />
</BaseLayout>
