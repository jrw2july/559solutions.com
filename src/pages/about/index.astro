---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CTASection from "@/components/CTASection.astro";
import OwnerName from "@/components/OwnerName.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

---

<BaseLayout
  title="About 559 Solutions | Practical Systems by Joel Wells"
  description="Learn how Joel Wells and 559 Solutions turn complicated work into practical tools, plain-language guidance, and reusable systems."
  canonicalPath="/about/"
  planCaption="The architect"
>
  <section class="page-hero plan-ground about-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About 559" }]} />
      <div class="about-me">
        <h1 class="eyebrow">About 559 Solutions</h1>
        <p>
          An architect draws the plan before anyone builds. That is how 559 Solutions works: before a tool is chosen, the work is understood. This site is drawn the same way.
        </p>
        <p>
          <OwnerName /> is a solution architect, mentor, teacher, and builder. For more than three decades, he has helped teams understand complicated work and turn it into systems people can actually use.
        </p>
        <p>
          559 Solutions is where he translates that experience into practical tools, plain-language guidance, reusable resources, and focused services.
        </p>
      </div>
    </div>
  </section>

  <CTASection
    title="Bring the messy version."
    description="You do not need to explain the problem in technical language."
    primaryLabel="Tell Me What Is Not Working"
    primaryHref="/contact/"
    secondaryLabel="Explore Practical Resources"
    secondaryHref="/resources/"
  />
</BaseLayout>
