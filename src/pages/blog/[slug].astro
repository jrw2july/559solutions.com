---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleCard from "@/components/ArticleCard.astro";
import AuthorBio from "@/components/AuthorBio.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CategoryIcon from "@/components/CategoryIcon.astro";
import CTASection from "@/components/CTASection.astro";
import DoodleDivider from "@/components/DoodleDivider.astro";
import OwnerName from "@/components/OwnerName.astro";
import TagList from "@/components/TagList.astro";
import ArticleBody from "@/components/ieia/ArticleBody.astro";
import IeiaSection from "@/components/ieia/IeiaSection.astro";
import QuestionWorthAsking from "@/components/ieia/QuestionWorthAsking.astro";
import UseItAtWork from "@/components/ieia/UseItAtWork.astro";
import WorkedExample from "@/components/ieia/WorkedExample.astro";
import { exercises } from "@/data/exercises";
import { absoluteUrl, site } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props as Props;
const { Content, headings } = await render(article);
const exercise = exercises[article.data.slug];
const worksheet = exercise?.apply?.kind === "worksheet" ? exercise.apply : undefined;
const readingTime = Math.max(1, Math.ceil((article.body || "").split(/\s+/).length / 225));
const publicationDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(article.data.publicationDate);
const updatedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(article.data.updatedDate);
const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const related = article.data.relatedArticles
  .map((slug) => allArticles.find((item) => item.data.slug === slug))
  .filter(Boolean)
  .slice(0, 3) as CollectionEntry<"articles">[];

const canonical =
  article.data.canonicalOverride || absoluteUrl(`/blog/${article.data.slug}/`);
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.data.title,
  description: article.data.summary,
  datePublished: article.data.publicationDate.toISOString(),
  dateModified: article.data.updatedDate.toISOString(),
  mainEntityOfPage: canonical,
  author: {
    "@type": "Person",
    name: article.data.author,
    // The About page is Joel Wells's profile; other authors get no link.
    ...(article.data.author === "Joel Wells" && { url: absoluteUrl("/about/"), sameAs: [site.linkedInUrl] }),
  },
  image: absoluteUrl(article.data.featuredImage ?? site.defaultSocialImage),
  publisher: {
    "@type": "Organization",
    name: "559 Solutions",
    url: absoluteUrl("/"),
    logo: { "@type": "ImageObject", url: absoluteUrl(site.logoPath) },
  },
};
---

<BaseLayout
  title={article.data.seoTitle}
  description={article.data.seoDescription}
  canonicalPath={`/blog/${article.data.slug}/`}
  canonicalOverride={article.data.canonicalOverride}
  image={article.data.featuredImage}
  type="article"
  structuredData={schema}
  bodyClass="curious"
>
  <header class="article-header">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "The Curious Architect", href: "/blog/" },
          { label: article.data.title },
        ]}
      />
      <p class="eyebrow ca-category"><CategoryIcon category={article.data.category} size={36} />{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <p class="article-summary">{article.data.summary}</p>
      <div class="article-byline">
        <span>By <OwnerName name={article.data.author} /></span>
        <span>Published <time datetime={article.data.publicationDate.toISOString()}>{publicationDate}</time></span>
        <span>Updated <time datetime={article.data.updatedDate.toISOString()}>{updatedDate}</time></span>
        <span>{readingTime} min read</span>
      </div>
      <TagList tags={article.data.tags} />
    </div>
  </header>

  <section class="section">
    <ArticleBody slug={article.data.slug} headingCount={headings.length} explain={exercise?.explain}>
      <Content />
      {
        (exercise?.scenario || exercise?.introduce) && (
          <IeiaSection slot="introduce" step="Introduce" id="lesson-introduce">
            {exercise.scenario && (
              <p class="ieia-scenario">
                <strong>{exercise.scenario.label}:</strong> {exercise.scenario.text}
              </p>
            )}
            {exercise.introduce && <QuestionWorthAsking id="lesson-question" data={exercise.introduce} />}
          </IeiaSection>
        )
      }
      {
        exercise?.illustrate && (
          <IeiaSection slot="illustrate" step="Illustrate" heading={exercise.illustrate.heading} id="lesson-illustrate">
            <WorkedExample data={exercise.illustrate} />
          </IeiaSection>
        )
      }
      {
        worksheet && (
          <IeiaSection slot="apply" step="Apply" heading={worksheet.title} id="lesson-apply">
            {exercise.applyLead && <p>{exercise.applyLead}</p>}
            <UseItAtWork data={worksheet} printTitle={article.data.title} labelledBy="lesson-apply-heading" />
            {/* Slot: newsletter signup after the Apply step, tagged with the article slug (Prompt 4). */}
          </IeiaSection>
        )
      }
      <Fragment slot="after">
        <DoodleDivider />
        <AuthorBio />
        {/* Slot: end-of-article newsletter signup and "Work with me" block (Prompts 4 and 5). */}
      </Fragment>
    </ArticleBody>
  </section>

  {
    related.length > 0 && (
      <section class="section section-tinted">
        <div class="container">
          <h2>Related articles</h2>
          <div class="card-grid">
            {related.map((item) => (
              <ArticleCard
                title={item.data.title}
                slug={item.data.slug}
                summary={item.data.summary}
                category={item.data.category}
                date={item.data.publicationDate}
                tags={item.data.tags}
                showIcon
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTASection
    title="Start with the next useful question."
    description="Use a related resource to make the work, decision, and ownership clearer."
    primaryLabel={article.data.relatedResourceCta?.label || "Explore Practical Resources"}
    primaryHref={article.data.relatedResourceCta?.href || "/resources/"}
    secondaryLabel="Read Another Article"
    secondaryHref="/blog/"
  />
</BaseLayout>
