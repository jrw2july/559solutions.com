---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleCard from "@/components/ArticleCard.astro";
import AuthorBio from "@/components/AuthorBio.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CategoryIcon from "@/components/CategoryIcon.astro";
import DoodleDivider from "@/components/DoodleDivider.astro";
import NewsletterForm from "@/components/NewsletterForm.astro";
import OwnerName from "@/components/OwnerName.astro";
import TagList from "@/components/TagList.astro";
import WorkWithMe from "@/components/WorkWithMe.astro";
import ArticleBody from "@/components/ieia/ArticleBody.astro";
import GoDeeper from "@/components/ieia/GoDeeper.astro";
import IeiaSection from "@/components/ieia/IeiaSection.astro";
import MakeTheCall from "@/components/ieia/MakeTheCall.astro";
import ScenarioSteps from "@/components/ieia/ScenarioSteps.astro";
import SelfCheck from "@/components/ieia/SelfCheck.astro";
import QuestionWorthAsking from "@/components/ieia/QuestionWorthAsking.astro";
import UseItAtWork from "@/components/ieia/UseItAtWork.astro";
import TradeDiagram from "@/components/ieia/TradeDiagram.astro";
import ContextDiagram from "@/components/ieia/ContextDiagram.astro";
import WorkedExample from "@/components/ieia/WorkedExample.astro";
import { exercises } from "@/data/exercises";
import { absoluteUrl, site, sitePath } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props as Props;
const { Content, headings } = await render(article);
const exercise = exercises[article.data.slug];
const apply = exercise?.apply;
const readingTime = Math.max(1, Math.ceil((article.body || "").split(/\s+/).length / 225));
const publicationDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(article.data.publicationDate);
const updatedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(article.data.updatedDate);
const allArticles = await getCollection("articles", ({ data }) => !data.draft);

// Reading sequence (2026-11-05): the articles that share this one's `series`, in `seriesOrder`.
const series = article.data.series;
const sequence = series
  ? allArticles
      .filter((item) => item.data.series === series && item.data.seriesOrder)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const stepIndex = sequence.findIndex((item) => item.data.slug === article.data.slug);
const step = stepIndex >= 0 ? { number: stepIndex + 1, total: sequence.length } : undefined;
const nextInSeries = step && step.number < step.total ? sequence[step.number] : undefined;
const firstInSeries = step ? sequence[0] : undefined;
const related = article.data.relatedArticles
  .map((slug) => allArticles.find((item) => item.data.slug === slug))
  .filter(Boolean)
  .slice(0, 3) as CollectionEntry<"articles">[];

const canonical =
  article.data.canonicalOverride || absoluteUrl(`/blog/${article.data.slug}/`);
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.data.title,
  description: article.data.summary,
  datePublished: article.data.publicationDate.toISOString(),
  dateModified: article.data.updatedDate.toISOString(),
  mainEntityOfPage: canonical,
  author: {
    "@type": "Person",
    name: article.data.author,
    // The About page is Joel Wells's profile; other authors get no link.
    ...(article.data.author === "Joel Wells" && { url: absoluteUrl("/about/"), sameAs: [site.linkedInUrl] }),
  },
  image: absoluteUrl(article.data.featuredImage ?? site.defaultSocialImage),
  publisher: {
    "@type": "Organization",
    name: "559 Solutions",
    url: absoluteUrl("/"),
    logo: { "@type": "ImageObject", url: absoluteUrl(site.logoPath) },
  },
};
---

<BaseLayout
  title={article.data.seoTitle}
  description={article.data.seoDescription}
  canonicalPath={`/blog/${article.data.slug}/`}
  canonicalOverride={article.data.canonicalOverride}
  image={article.data.featuredImage}
  type="article"
  structuredData={schema}
  bodyClass="curious"
>
  <header class="article-header">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "The Curious Architect", href: "/blog/" },
          { label: article.data.title },
        ]}
      />
      <p class="eyebrow ca-category"><CategoryIcon category={article.data.category} size={36} />{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <p class="article-summary">{article.data.summary}</p>
      <div class="article-byline">
        <span>By <OwnerName name={article.data.author} /></span>
        <span>Published <time datetime={article.data.publicationDate.toISOString()}>{publicationDate}</time></span>
        <span>Updated <time datetime={article.data.updatedDate.toISOString()}>{updatedDate}</time></span>
        <span>{readingTime} min read</span>
      </div>
      {
        step && (
          <p class="series-step">
            Step {step.number} of {step.total} <span aria-hidden="true">·</span> {series}
          </p>
        )
      }
      <TagList tags={article.data.tags} />
    </div>
  </header>

  <section class="section">
    <ArticleBody slug={article.data.slug} headingCount={headings.length} explain={exercise?.explain}>
      <Content />
      {
        (exercise?.scenario || exercise?.introduce) && (
          <IeiaSection slot="introduce" step="Introduce" id="lesson-introduce">
            {exercise.scenario && (
              <p class="ieia-scenario">
                <strong>{exercise.scenario.label}:</strong> {exercise.scenario.text}
              </p>
            )}
            {exercise.introduce && <QuestionWorthAsking id="lesson-question" data={exercise.introduce} />}
          </IeiaSection>
        )
      }
      {
        exercise?.illustrate && (
          <IeiaSection slot="illustrate" step="Illustrate" heading={exercise.illustrate.heading} id="lesson-illustrate">
            {exercise.diagram && <TradeDiagram id="lesson-diagram" data={exercise.diagram} />}
            {exercise.contextDiagram && <ContextDiagram id="lesson-diagram" data={exercise.contextDiagram} />}
            <WorkedExample data={exercise.illustrate} />
          </IeiaSection>
        )
      }
      {
        apply && (
          <IeiaSection slot="apply" step="Apply" heading={apply.title} id="lesson-apply">
            {exercise.applyLead && <p>{exercise.applyLead}</p>}
            {apply.kind === "worksheet" && (
              <UseItAtWork data={apply} printTitle={article.data.title} labelledBy="lesson-apply-heading" />
            )}
            {apply.kind === "selfcheck" && <SelfCheck data={apply} labelledBy="lesson-apply-heading" />}
            {apply.kind === "scenario" && <ScenarioSteps data={apply} />}
            {apply.kind === "call" && <MakeTheCall data={apply} />}
            {exercise.goDeeper && <GoDeeper id="lesson-deeper" data={exercise.goDeeper} />}
          </IeiaSection>
        )
      }
      <Fragment slot="after">
        {
          step && (
            <nav class="series-next" aria-label="Reading sequence">
              <p class="series-next-kicker">{series} <span aria-hidden="true">·</span> Step {step.number} of {step.total}</p>
              {
                nextInSeries ? (
                  <p>
                    <a class="series-next-link" href={sitePath(`/blog/${nextInSeries.data.slug}/`)}>
                      Next: {nextInSeries.data.title}
                    </a>
                  </p>
                ) : (
                  <p>
                    This is the last step. <a class="series-next-link" href={sitePath(`/blog/${firstInSeries?.data.slug}/`)}>Back to step 1: {firstInSeries?.data.title}</a>
                  </p>
                )
              }
            </nav>
          )
        }
        <DoodleDivider />
        <AuthorBio />
        <NewsletterForm id="newsletter-article-end" tag={`article-end-${article.data.slug}`} />
      </Fragment>
    </ArticleBody>
  </section>

  {
    related.length > 0 && (
      <section class="section section-tinted">
        <div class="container">
          <h2>Related articles</h2>
          <div class="card-grid">
            {related.map((item) => (
              <ArticleCard
                title={item.data.title}
                slug={item.data.slug}
                summary={item.data.summary}
                category={item.data.category}
                date={item.data.publicationDate}
                tags={item.data.tags}
                showIcon
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <WorkWithMe serviceSlug={article.data.service} resource={article.data.relatedResourceCta} />
</BaseLayout>
