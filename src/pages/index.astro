---
import { getCollection } from "astro:content";
import ArticleCard from "@/components/ArticleCard.astro";
import CTASection from "@/components/CTASection.astro";
// Used only by the "How 559 Solutions works" section, which is commented out below (2026-10-14).
// import FloorplanDivider from "@/components/FloorplanDivider.astro";
import FrontDoor from "@/components/FrontDoor.astro";
import OwnerName from "@/components/OwnerName.astro";
// import ProblemCard from "@/components/ProblemCard.astro";
import RoomDoor from "@/components/RoomDoor.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import TitleBlock from "@/components/TitleBlock.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, site, sitePath } from "@/config/site";
import { rooms } from "@/data/rooms";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf())
  .slice(0, 3);

const organizationSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.siteName,
    url: absoluteUrl("/"),
    description:
      "Practical AI, automation, low-code resources, and plain-language systems guidance.",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.siteName,
    url: absoluteUrl("/"),
    logo: absoluteUrl(site.logoPath),
  },
];

---

<BaseLayout
  title="559 Solutions | Practical AI, Low-Code Tools & Clear Systems"
  description="Practical AI, automation, low-code resources, and plain-language systems guidance for small teams, business owners, nonprofit leaders, and builders."
  canonicalPath="/"
  structuredData={organizationSchema}
>
  <section class="plan-hero plan-ground">
    <div class="container">
      <div class="plan-hero-copy">
        <h1><span class="h1-lead">C’mon in.</span> <span class="h1-rest">Every room opens onto a clearer way to work.</span></h1>
        {/*
          Hero lede set aside (2026-10-14). To bring it back, remove this comment wrapper.

        <p class="hero-lede">
          Turn messy work into clear systems. This is the whole site on one floor plan: come in the front door, or walk straight into the room you need.
        </p>
        */}
      </div>

      <div class="plan-wrap">
        <nav aria-label="Site map">
          <ul class="walled plan">
            {
              rooms.map((room, index) => (
                <li class={`plan-${room.id}`}>
                  <a class="plan-room" href={sitePath(room.href)}>
                    <span class="plan-tag">Room {String(index + 1).padStart(2, "0")}</span>
                    <span class="plan-name">{room.label}</span>
                    {room.showPage && <span class="plan-page">{room.page}</span>}
                    <span class="plan-blurb">{room.blurb}</span>
                    <span class="plan-go">{room.go}</span>
                    <RoomDoor side={room.side} />
                  </a>
                </li>
              ))
            }
            <li class="plan-hall" aria-hidden="true">
              <FrontDoor />
            </li>
          </ul>
        </nav>
      </div>

      <div class="plan-footer">
        <p class="plan-tag">Sheet A-101 · Plan view · Drawn by <OwnerName /></p>
      </div>
    </div>
  </section>

  {/*
    "How 559 Solutions works" (three method rooms) is set aside for now (2026-10-14): its rooms clash with the
    floor plan above. To bring it back, remove this comment wrapper and restore the two imports at the top.

  <section class="section" id="how-it-works">
    <div class="container">
      <SectionHeading
        eyebrow="How 559 Solutions works"
        title="Three rooms, one path through."
        description="AI is one possible tool. The method begins with the work and ends with a system people can understand and maintain."
      />
      <div class="walled rooms">
        <ProblemCard
          number="01"
          title="Clarify the work"
          description="Identify the decision, repeated task, bottleneck, missing ownership, source of confusion, and desired outcome."
        />
        <ProblemCard
          number="02"
          title="Design the simplest useful system"
          description="Choose the smallest appropriate response, such as a workflow, template, low-code application, dashboard, or automation."
        />
        <ProblemCard
          number="03"
          title="Make it reusable"
          description="Document, automate, teach, package, and improve what works so the result does not depend on one person remembering everything."
        />
      </div>
      <FloorplanDivider />
    </div>
  </section>
  */}

  {
    articles.length > 0 && (
      <section class="section section-tinted">
        <div class="container">
          <SectionHeading
            eyebrow="From the Study"
            title="Ideas for clearer systems and calmer technology decisions."
            description="The latest from The Curious Architect, the 559 Solutions blog."
          />
          <div class="card-grid">
            {articles.map((article) => (
              <ArticleCard
                title={article.data.title}
                slug={article.data.slug}
                summary={article.data.summary}
                category={article.data.category}
                date={article.data.publicationDate}
                tags={article.data.tags}
              />
            ))}
          </div>
          <p><a class="text-link" href={sitePath("/blog/")}>All articles</a></p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container about-strip">
      <div>
        <p class="eyebrow">From the Office</p>
        <h2>Experience translated into practical tools.</h2>
        <p>
          I am <OwnerName />, a solution architect, mentor, teacher, and builder. For more than three decades, I have helped teams understand complicated work and turn it into systems people can actually use.
        </p>
        <p>
          559 Solutions is where I translate that experience into practical tools, plain-language guidance, and reusable resources.
        </p>
        <a class="button button-secondary" href={sitePath("/about/")}>Read the 559 Story</a>
      </div>
      <TitleBlock />
    </div>
  </section>

  <CTASection
    title="Start with clarity, not another tool."
    description="Describe the work that keeps repeating. Plain language is enough."
    primaryLabel="Tell Me What Is Not Working"
    primaryHref="/contact/"
    secondaryLabel="Explore Practical Resources"
    secondaryHref="/resources/"
  />
</BaseLayout>
