---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, sitePath } from "@/config/site";
import { code559Offerings } from "@/data/code559-offerings";

const comingSoon = code559Offerings.filter((item) => item.status === "Coming soon");
const notifyReady = Boolean(site.newsletterEndpoint);
---

<BaseLayout
  title="Code559 | Coding and AI Tools for Regular People"
  description="Code559 is an initiative of 559 Solutions to help regular people use coding and AI tools to get results."
  canonicalPath="/code559/"
  image="/images/og-code559.png"
  imageAlt="Code559 free lessons: Learn front-end development from zero. 14 modules: HTML, CSS, JavaScript, Git and GitHub."
  bodyClass="code559"
>
  <section class="section-compact code559-intro">
    <div class="container">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Code559" }]} />
      <div class="code559-sheet">
        <h1 class="code559-logo">
          <img src={sitePath("/images/code559-logo.png")} alt="" width="760" height="308" />
          <span class="visually-hidden">Code559: coding and AI tools for regular people</span>
        </h1>
        <p>
          Code559 is an initiative to help regular people use coding and AI tools to get results. No computer
          science degree and no hype: plain language, the real tools, and work you can see when you finish.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-tinted" id="offerings">
    <div class="container">
      <SectionHeading
        eyebrow="Courses"
        title="Start where you are."
      />
      <div class="offering-grid">
        {
          code559Offerings.map((item) => (
            <article class:list={["card", "offering-card", item.status === "Available" && "offering-available"]} id={item.id}>
              <StatusBadge status={item.status} />
              <h3>
                {item.href ? <a href={sitePath(item.href)}>{item.title}</a> : item.title}
              </h3>
              <p>{item.summary}</p>
              {item.facts && (
                <ul class="offering-facts">
                  {item.facts.map((fact) => <li>{fact}</li>)}
                </ul>
              )}
              {item.href ? (
                <a class="text-link" href={sitePath(item.href)}>Go to the course</a>
              ) : (
                <a class="text-link offering-soon" href="#code559-notify">Get notified when it opens</a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="code559-notify">
    <div class="container">
      <div class="signup-card">
        <div>
          <p class="eyebrow">Coming soon</p>
          <h2 id="code559-notify-heading">Hear when the next course opens</h2>
          <p>Leave your email and pick a course. You will get one email when it opens.</p>
        </div>
        <form
          class="form-panel"
          action={notifyReady ? site.newsletterEndpoint : undefined}
          method="post"
          aria-labelledby="code559-notify-heading"
          data-ajax-form={notifyReady ? "code559-coming-soon" : undefined}
          data-success-message="Thanks, you're on the list. You'll get one email when that course opens."
        >
          <div class="form-grid">
            <div class="field">
              <label for="code559-first-name">First name</label>
              <input id="code559-first-name" name="first_name" type="text" autocomplete="given-name" required />
            </div>
            <div class="field">
              <label for="code559-email">Email</label>
              <input id="code559-email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>
          <div class="field">
            <label for="code559-course">Course</label>
            <select id="code559-course" name="course" required>
              <option value="">Choose one</option>
              {comingSoon.map((item) => <option value={item.id}>{item.title}</option>)}
              <option value="all">All of them</option>
            </select>
          </div>
          <div class="honeypot" aria-hidden="true">
            <label for="code559-company-website">Leave this field blank</label>
            <input id="code559-company-website" name={site.antiSpamField} type="text" tabindex="-1" autocomplete="off" />
          </div>
          <label class="checkbox-field">
            <input name="consent" type="checkbox" required />
            <span>I agree that 559 Solutions may email me when this course opens. See the <a href={sitePath("/privacy/")}>Privacy Policy</a>.</span>
          </label>
          <button class="button button-primary" type="submit" disabled={!notifyReady}>Notify Me</button>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
